APP_ENV=local
SISAP_BASE_URL=http://sistemas.midagri.gob.pe/sisap/portal2/mayorista/
SISAP_CIUDADES_URL=http://sistemas.midagri.gob.pe/sisap/portal2/ciudades/
SISAP_TIMEOUT_SECONDS=30
SISAP_RETRY_INTENTOS=3
SISAP_RETRY_ESPERA_SEGUNDOS=3
SISAP_OUTPUT_DIR=data/raw
SISAP_FECHA_INICIO=2016-01-01
SISAP_FECHA_FIN=
SISAP_MODO_CARGA=incremental
SISAP_INCREMENTAL_OVERLAP_DIAS=0
SISAP_PROCEDENCIA_CODIGO=
SISAP_PROCEDENCIA_NOMBRE=
SISAP_REGION_CODIGO=
SISAP_REGION_NOMBRE=
SISAP_MERCADO_CODIGO=
SISAP_MERCADO_NOMBRE=
SISAP_PRODUCTO_CODIGO=
SISAP_PRODUCTO_NOMBRE=
SISAP_MAX_QUERIES=
SISAP_MODULOS=volumen,precios,ciudades-mayoristas,ciudades-minoristas
SISAP_PROCEDENCIAS=all
SISAP_REGIONES=all
SISAP_MERCADOS=all
SISAP_PAUSE_SECONDS=30

STORAGE_BACKEND=minio
DELTA_ENABLED=true
MINIO_ENDPOINT=http://tu-endpoint-minio:9000
MINIO_ACCESS_KEY=tu-access-key
MINIO_SECRET_KEY=tu-secret-key
MINIO_BUCKET=agro-productos
MINIO_REGION=us-east-1
MINIO_PREFIX=Landing/sisap
